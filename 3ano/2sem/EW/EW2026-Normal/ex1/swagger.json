{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "API Jogos de Tabuleiro",
    "description": "API de dados desenvolvida para o Teste de Engenharia Web"
  },
  "host": "localhost:17000",
  "basePath": "/",
  "schemes": ["http"],
  "paths": {
    "/jogos": {
      "get": {
        "description": "Devolve a lista de todos os jogos ou filtra por editora",
        "parameters": [
          { "name": "editora", "in": "query", "type": "string", "required": false }
        ],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "description": "Adiciona um novo jogo",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object" } }
        ],
        "responses": { "201": { "description": "Criado" } }
      }
    },
    "/jogos/{id}": {
      "get": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "put": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object" } }
        ],
        "responses": { "200": { "description": "Atualizado" } }
      },
      "delete": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Eliminado" } }
      }
    },
    "/autores": { "get": { "responses": { "200": { "description": "Sucesso" } } } },
    "/categorias": { "get": { "responses": { "200": { "description": "Sucesso" } } } }
  }
}