extends layout.pug

block content
  .w3-container
    h2 Lista de Publicações (#{pubs.length})
    .w3-bar
      a.w3-button.w3-round-large.w3-teal.w3-margin(href="/publicacoes/stats") Estatísticas
    table.w3-table-all
      tr.w3-teal
        th Id
        th Tipo
        th Título
        th Ano
      each p in pubs
        tr
          td= p.id
          td= p.type
          td= p.title
          td= p.year