<world>
    <window width="1280" height="720" />

    <camera>
        <position x="40" y="50" z="60" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="1000" />
    </camera>

    <group>

        <!-- Sun -->
        <group>
            <transform>
                <!-- Sun's rotation on its axis -->
                <rotate time="25" x="0" y="1" z="0" />
                <scale x="3" y="3" z="3" />
            </transform>
            <models>
                <model file="sphere.3d" />
            </models>
        </group>

        <!-- Mercury -->
        <group>
            <transform>
                <!-- Orbit around the sun -->
                <rotate time="8.8" x="0" y="1" z="0" />
                <translate x="6" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <!-- Local spin -->
                    <rotate time="5.8" x="0" y="1" z="0" />
                    <scale x="0.3" y="0.3" z="0.3" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Venus -->
        <group>
            <transform>
                <rotate time="22.5" x="0" y="1" z="0" />
                <translate x="9" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <rotate time="24.3" x="0" y="-1" z="0" /> <!-- Retrograde spin -->
                    <scale x="0.5" y="0.5" z="0.5" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Earth -->
        <group>
            <transform>
                <rotate time="36.5" x="0" y="1" z="0" />
                <translate x="13" y="0" z="0" />
            </transform>
            <!-- Earth Globe -->
            <group>
                <transform>
                    <rotate time="1.0" x="0" y="1" z="0" />
                    <scale x="0.55" y="0.55" z="0.55" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Moon -->
            <group>
                <transform>
                    <rotate time="2.7" x="0" y="1" z="0" />
                    <translate x="1.5" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <rotate time="2.7" x="0" y="1" z="0" /> <!-- tidally locked -->
                        <scale x="0.15" y="0.15" z="0.15" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
        </group>

        <!-- Mars -->
        <group>
            <transform>
                <rotate time="68.7" x="0" y="1" z="0" />
                <translate x="17" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <rotate time="1.03" x="0" y="1" z="0" />
                    <scale x="0.4" y="0.4" z="0.4" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Phobos -->
            <group>
                <transform>
                    <rotate time="0.3" x="0" y="1" z="0" />
                    <translate x="1" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <scale x="0.08" y="0.08" z="0.08" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
        </group>

        <!-- Jupiter -->
        <group>
            <transform>
                <rotate time="433.2" x="0" y="1" z="0" />
                <translate x="22" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <rotate time="0.41" x="0" y="1" z="0" />
                    <scale x="1.8" y="1.8" z="1.8" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Io -->
            <group>
                <transform>
                    <rotate time="1.7" x="0" y="1" z="0" />
                    <translate x="3" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <scale x="0.15" y="0.15" z="0.15" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
            <!-- Europa -->
            <group>
                <transform>
                    <rotate time="3.5" x="0" y="1" z="0" />
                    <translate x="3.5" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <scale x="0.13" y="0.13" z="0.13" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
            <!-- Ganymede -->
            <group>
                <transform>
                    <rotate time="7.1" x="0" y="1" z="0" />
                    <translate x="4.2" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <scale x="0.2" y="0.2" z="0.2" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
        </group>

        <!-- Saturn -->
        <group>
            <transform>
                <rotate time="1075.9" x="0" y="1" z="0" />
                <translate x="30" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <rotate time="0.45" x="0" y="1" z="0" />
                    <scale x="1.5" y="1.5" z="1.5" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Titan -->
            <group>
                <transform>
                    <rotate time="15.9" x="0" y="1" z="0" />
                    <translate x="3" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <scale x="0.2" y="0.2" z="0.2" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
        </group>

        <!-- Uranus -->
        <group>
            <transform>
                <rotate time="3068.8" x="0" y="1" z="0" />
                <translate x="36" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <!-- Uranus rolls on its side -->
                    <rotate time="0.71" x="1" y="0" z="0" />
                    <scale x="0.9" y="0.9" z="0.9" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
        </group>

        <!-- Neptune -->
        <group>
            <transform>
                <rotate time="6018.2" x="0" y="1" z="0" />
                <translate x="41" y="0" z="0" />
            </transform>
            <group>
                <transform>
                    <rotate time="0.67" x="0" y="1" z="0" />
                    <scale x="0.85" y="0.85" z="0.85" />
                </transform>
                <models>
                    <model file="sphere.3d" />
                </models>
            </group>
            <!-- Triton -->
            <group>
                <transform>
                    <rotate time="5.8" x="0" y="1" z="0" />
                    <translate x="2" y="0" z="0" />
                </transform>
                <group>
                    <transform>
                        <scale x="0.12" y="0.12" z="0.12" />
                    </transform>
                    <models>
                        <model file="sphere.3d" />
                    </models>
                </group>
            </group>
        </group>

        <!-- Halley's Comet -->
        <group>
            <transform>
                <translate time="76" align="true">
                    <point x="0" y="5" z="45" />
                    <point x="20" y="0" z="20" />
                    <point x="2" y="-2" z="-2" />
                    <point x="-20" y="0" z="20" />
                    <point x="-10" y="3" z="40" />
                </translate>
                <rotate angle="-90" x="1" y="0" z="0" />
                <scale x="0.3" y="0.3" z="0.3" />
            </transform>
            <models>
                <!-- Using the teapot for a funny comet -->
                <model file="bezier.3d" />
            </models>
        </group>

    </group>
</world>